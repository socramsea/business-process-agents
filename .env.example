# Modelo. Copie para .env e preencha. O .env NUNCA vai pro git.
# Template. Copy to .env and fill in. The .env NEVER goes to git.
#
#   cp .env.example .env
#
# Pegue a chave em: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-coloque-a-sua-aqui

# Só se for usar o enricher da OpenAI (enrichers/mensagem_openai.py).
# Only needed for the OpenAI enricher.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-coloque-a-sua-aqui

# Evolution API — canal de entrada do WhatsApp (Etapa 3).
# Só necessário quando o polling entrar; o CLI funciona sem isto.
# Only needed once polling is wired; the CLI works without these.
EVOLUTION_URL=https://sua-instancia-evolution.com
EVOLUTION_API_KEY=coloque-a-sua-aqui
EVOLUTION_INSTANCE=nome-da-instancia

# ---- Banco ----
# Sem DATABASE_URL o sistema roda em SQLite (memoria.db) e o CLI funciona
# normalmente. Com ela, o estado vai para o Postgres e o schema passa a ser
# das migrações:  alembic upgrade head
# Without DATABASE_URL the system runs on SQLite; with it, Postgres + migrations.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/agentes

# Banco de TESTE, e ele PRECISA ser outro banco. O preparo dos testes dá
# TRUNCATE na tabela de leads; apontar isto para produção apaga cliente.
# core/config.py recusa rodar se as duas forem iguais, mas a primeira linha de
# defesa é você preencher certo aqui.
# The TEST database MUST be a different one — the suite truncates it.
DATABASE_URL_TESTE=postgresql://usuario:senha@localhost:5432/agentes_teste
